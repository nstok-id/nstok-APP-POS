# ==============================================================================
# nstok-APP-POS: Environment Variables Configuration
# ==============================================================================
# Salin file ini menjadi .env.local untuk pengembangan lokal (development)
# atau masukkan ke Dashboard Environment Variables (Vercel / Hosting)
#
# 1. Buka Supabase Dashboard (https://supabase.com/dashboard)
# 2. Buka Project Anda -> Project Settings (Ikon Gerigi) -> Database
# 3. Temukan bagian "Connection string" -> Pilih tab "URI"
# 4. Pilih Mode:
#    - "Transaction Pooler" (port 6543) [Direkomendasikan untuk Serverless / Next.js]
#    - ATAU "Session Pooler" (port 5432)
# 5. Ganti [YOUR-PASSWORD] dengan kata sandi database Supabase Anda.
# ==============================================================================

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-SUPABASE-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

